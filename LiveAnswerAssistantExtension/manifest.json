{
  "manifest_version": 3,
  "name": "Live Answer Assistant",
  "version": "1.0.0",
  "description": "Draft polished answers to live client and interview questions using your AutoApply CV dashboard resume context.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://autoapplycv.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://autoapplycv.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Answer Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
