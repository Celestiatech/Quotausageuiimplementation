{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "es2022"
                                    ],
                            "allowJs":  false,
                            "skipLibCheck":  true,
                            "strict":  false,
                            "noFallthroughCasesInSwitch":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "incremental":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "baseUrl":  ".",
                            "paths": {
                                "@/*": ["./*"]
                            }
                        },
    "include":  [
                    "next-env.d.ts",
                    "app/**/*.ts",
                    "app/**/*.tsx",
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    "middleware.ts",
                    ".next/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "**/node_modules",
                    "AutoApplyCvMeetCopilotLiveExtension",
                    "Auto_job_applier_linkedIn",
                    "CareerPilotIndeedExtension",
                    "CareerPilotLinkedInExtension",
                    "HROutreachExtension",
                    "JobsSmartOutreachExtension",
                    "whatsapp-extension",
                    "extensiondesign",
                    ".opencode",
                    ".claude",
                    "src/main.tsx",
                    "vite.config.ts"
                ]
}
